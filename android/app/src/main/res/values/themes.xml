<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 全局唯一深色主题：本项目只做深色，不随系统切换 -->
    <style name="Theme.RunClub" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_lime</item>
        <item name="colorOnPrimary">@color/bg_base</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="colorOnSecondary">@color/bg_base</item>
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:statusBarColor">@color/bg_outer</item>
        <item name="android:navigationBarColor">@color/bg_outer</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
        点号命名的样式会隐式继承同名前缀（Text.Brand -> Text，Widget.RunClub.PrimaryButton -> Widget.RunClub -> Widget）。
        下面两个空基类用于让该隐式继承链可解析，本身不承载任何属性。
    -->
    <style name="Text" />
    <style name="Widget" />
    <style name="Widget.RunClub" />

    <!-- 文本样式 -->
    <style name="Text.Brand">
        <item name="android:textColor">@color/accent_lime</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
    </style>

    <style name="Text.Label">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.18</item>
    </style>

    <style name="Text.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Text.Body">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Text.Display">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 主按钮：荧光绿胶囊 -->
    <style name="Widget.RunClub.PrimaryButton">
        <item name="android:background">@drawable/bg_pill_lime</item>
        <item name="android:textColor">@color/bg_base</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 次按钮：深色描边胶囊 -->
    <style name="Widget.RunClub.SecondaryButton">
        <item name="android:background">@drawable/bg_pill_dark</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 卡片 -->
    <style name="Widget.RunClub.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">22dp</item>
    </style>

</resources>
