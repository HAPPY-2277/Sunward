<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 全局唯一浅色主题：本项目只做浅色暖底（方案三·蜜琥珀），不随系统切换 -->
    <style name="Theme.RunClub" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent_lime</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:statusBarColor">@color/bg_outer</item>
        <item name="android:navigationBarColor">@color/bg_outer</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
        点号命名的样式会隐式继承同名前缀（Text.Brand -> Text，Widget.RunClub.PrimaryButton -> Widget.RunClub -> Widget）。
        下面两个空基类用于让该隐式继承链可解析，本身不承载任何属性。
    -->
    <style name="Text" />
    <style name="Widget" />
    <style name="Widget.RunClub" />

    <!-- 文本样式 -->
    <style name="Text.Brand">
        <item name="android:textColor">@color/accent_deep</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
    </style>

    <style name="Text.Label">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.18</item>
    </style>

    <style name="Text.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Text.Body">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Text.Display">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 主按钮：蜜琥珀胶囊（墨字） -->
    <style name="Widget.RunClub.PrimaryButton">
        <item name="android:background">@drawable/bg_pill_lime</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 次按钮：暖灰描边胶囊（墨字） -->
    <style name="Widget.RunClub.SecondaryButton">
        <item name="android:background">@drawable/bg_pill_dark</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 卡片 -->
    <style name="Widget.RunClub.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">22dp</item>
    </style>

    <!-- 首页专用 -->
    <style name="Text.Eyebrow">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.SectionTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.WeeklyLabel">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.WeeklyValue">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.WeeklyUnit">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.WeeklyFooter">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!--
        统一提示卡片（ui/widget/SunwardDialog.kt + layout/dialog_sunward.xml）。
        不依赖系统 AlertDialog 的配色，卡片外观全部画在自己的布局里，
        这里只负责「透明窗口 + 居中 + 遮罩 + 淡入淡出」。
    -->
    <style name="Theme.RunClub.Dialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.RunClub.Dialog</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>

    <style name="Animation.RunClub.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

</resources>
