<?xml version="1.0" encoding="utf-8"?>
<!-- GO 按钮的涟漪环：只有描边、内部透明，对应原型 animate-ping 的
     `border border-[#080B08]/40`。
     这里曾经写成「实心深色圆盘 + 描边」，被放大后就是一圈明显的黑边，
     与原型（一圈细线向外扩散并淡出）完全不符，所以改回纯描边。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/ink_18" />
</shape>
