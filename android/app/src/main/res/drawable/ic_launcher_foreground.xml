<?xml version="1.0" encoding="utf-8"?>
<!-- 启动图标前景：sunward「朝阳金」（源文件 design/icon/sunward-icon.svg）
     暖色光晕 + 晨光金渐变闭环轨迹 + 落日红定位针。
     自适应图标安全区：内容按 0.86 缩放，包围盒中心 (496,531.5) 平移回画布中心 (512,512)，
     保证在 66dp 圆形安全区内完整显示，不被启动器遮罩裁切。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 满幅光晕：中心暖橙 26% → 60% 处 8% → 边缘全透明，被遮罩裁切也不露边 -->
    <path android:pathData="M512,0 A512,512 0 1,1 512,1024 A512,512 0 1,1 512,0">
        <aapt:attr name="fillColor">
            <gradient
                android:type="radial"
                android:centerX="512"
                android:centerY="512"
                android:gradientRadius="512">
                <item android:offset="0" android:color="#42FF9E45" />
                <item android:offset="0.6" android:color="#14FF8A3C" />
                <item android:offset="1" android:color="#00FF8A3C" />
            </gradient>
        </aapt:attr>
    </path>

    <group
        android:pivotX="496"
        android:pivotY="531.5"
        android:scaleX="0.86"
        android:scaleY="0.86"
        android:translateX="16"
        android:translateY="-19.5">

        <!-- 轨迹闭环：晨光金渐变描边 -->
        <path
            android:pathData="M512,370 C668,370 800,470 812,596 C824,722 716,816 572,820 C428,824 296,770 232,670 C168,570 222,446 340,394 C384,374 446,370 512,370 Z"
            android:strokeWidth="62"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="190"
                    android:startY="370"
                    android:endX="820"
                    android:endY="830">
                    <item android:offset="0" android:color="#FFFFE49A" />
                    <item android:offset="0.52" android:color="#FFFFB65C" />
                    <item android:offset="1" android:color="#FFF0802C" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 起点定位针 -->
        <path
            android:pathData="M512,382 L458,312 A66,66 0 1,1 566,312 Z"
            android:fillColor="#E8502F" />
        <!-- 针孔（与背景色一致） -->
        <path
            android:pathData="M512,250 A24,24 0 1,1 512,298 A24,24 0 1,1 512,250 Z"
            android:fillColor="#1C1310" />
    </group>
</vector>
